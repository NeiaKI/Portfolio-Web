# ─── Supabase (cloud) ─────────────────────────────────────────────
# Project URL, mis. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (aman di client). Ambil dari Supabase > Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY, bypass RLS). JANGAN commit nilai asli.
SUPABASE_SERVICE_ROLE_KEY=

# ─── External APIs ───────────────────────────────────────────────
FMP_API_KEY=                  # Financial Modeling Prep — AUM ETF
WEB3FORMS_ACCESS_KEY=         # Contact form
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
WAKATIME_API_KEY=
GITHUB_TOKEN=                 # read-only, fallback data proyek
NEXT_PUBLIC_SITE_URL=         # https://domain-anda.com

# Brilliant tidak menyediakan API publik; isi progres secara manual.
BRILLIANT_STREAK=
BRILLIANT_TOTAL_XP=
BRILLIANT_LESSONS_COMPLETED=
BRILLIANT_COURSES_JSON=[]     # [{"title":"Computer Science","progress":65}]

# ─── Content sources ─────────────────────────────────────────────
MEDIUM_USERNAME=nateeki       # default username Medium
DEVTO_USERNAME=nateeki        # default username Dev.to

# ─── Public social / tip usernames (NEXT_PUBLIC_ = ke client) ────
NEXT_PUBLIC_ETH_ADDRESS=       # alamat ETH untuk tip
NEXT_PUBLIC_KOFI_USERNAME=     # Ko-fi username
NEXT_PUBLIC_TRAKTEER_USERNAME= # Trakteer username
